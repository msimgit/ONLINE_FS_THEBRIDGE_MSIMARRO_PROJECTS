// Sprint 9 - SQL con Prisma. Adaptado a Prisma 7 (driver adapter en prisma.config.ts).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// User: Sprint 10 (autenticación). Product: Sprint 9 (CRUD con Prisma).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carts  Cart[]
  orders Order[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  salePrice   Float?
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

// Sprint 12 - Carrito y Checkout (relaciones con User/Product de arriba).
enum CartStatus {
  ACTIVE
  CHECKED_OUT
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    CartStatus @default(ACTIVE)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

enum OrderStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  total           Float
  status          OrderStatus     @default(COMPLETED)
  items           OrderItem[]
  stripeSessionId String?         @unique
  returnRequests  ReturnRequest[]
  createdAt       DateTime        @default(now())
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  quantity           Int
  priceAtPurchase    Float
  originalPrice      Float?
  returnRequestItems ReturnRequestItem[]
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnRequest {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     ReturnStatus        @default(PENDING)
  items      ReturnRequestItem[]
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
}

model ReturnRequestItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  reason          String?
}
